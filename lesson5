# Dockerfile
ARG version=1
FROM busybox:$version
# httpd container
ENV HOME="/var/www/html/"
RUN mkdir $HOME
COPY index.html $HOME
EXPOSE 80
CMD ["-h", "/var/www/html/"]
ENTRYPOINT [ "httpd", "-f" ]

## vi操作が苦手な方は、以下のコマンドでDockerfileを作成してください ##
cat << EOF > Dockerfile
ARG version=1
FROM busybox:\$version
# httpd container
ENV HOME="/var/www/html/"
RUN mkdir \$HOME
COPY index.html \$HOME
EXPOSE 80
CMD ["-h", "/var/www/html/"]
ENTRYPOINT [ "httpd", "-f" ]
EOF


